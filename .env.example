# Kafka
KAFKA_BROKERS=kafka:29092
KAFKA_TOPIC=orders
# Where consumer groups start when they have NO committed offset yet
# (fresh groups / clean test runs): first = from the beginning of the
# topic, last = only new events. Groups with committed offsets always
# resume from their committed offset regardless of this value.
KAFKA_START_OFFSET=first

# PostgreSQL
POSTGRES_USER=""
POSTGRES_PASSWORD=""
POSTGRES_DB=orders
DATABASE_URL=""

# API
API_ADDR=:8080

